{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    // core resolved to source, matching the alias in vite.config.ts: its
    // `exports` point at dist/, which a clean clone has not built.
    "paths": { "dab-core": ["../core/src/index.ts"] }
  },
  "include": ["src/**/*.ts", "__tests__/**/*.ts", "*.config.ts"]
}
