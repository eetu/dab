{
  "name": "dab-core",
  "version": "0.1.0",
  "description": "dab's engine: the character-grid sprite format, its validator, and every pure operation on a sprite.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@anarkisti/eslint-config": "^1.0.0",
    "eslint": "^10.8.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.10"
  },
  "private": true
}
