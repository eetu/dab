{
  "name": "dab-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "validate": "yarn typecheck && yarn lint && yarn format",
    "test": "vitest run",
    "shots": "vitest run --config vitest.shots.config.ts"
  },
  "dependencies": {
    "@lucide/svelte": "^1.51.0",
    "dab-core": "workspace:*"
  },
  "devDependencies": {
    "@anarkisti/eslint-config": "^1.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.4",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "^10.12.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.2",
    "vitest-browser-svelte": "^3.1.0"
  }
}
