# Copy to backend/.env. Both settings have working defaults — the file exists so
# a local run can move the port or point at a different build.

# Where to listen. Loopback in dev; the container sets 0.0.0.0.
# DAB_BIND=127.0.0.1:3060

# The built SPA to serve. Relative paths resolve from the working directory, so
# this default assumes `cargo run` from the repo root; from inside backend/ it is
# ../frontend/dist.
# DAB_STATIC_DIR=frontend/dist

# RUST_LOG=info
